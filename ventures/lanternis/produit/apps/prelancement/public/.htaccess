# Lanternis · pré-lancement · Apache (o2switch, cPanel)
# Aucune donnée ni configuration dans ce dossier : config.php, lib/ et la base SQLite sont dans le dossier parent.

Options -Indexes -MultiViews
DirectoryIndex index.html
AddDefaultCharset utf-8
ServerSignature Off

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Validation des certificats AutoSSL (cPanel) : laissée intacte, en HTTP comme en HTTPS
  RewriteRule ^\.well-known/(acme-challenge|pki-validation)/ - [L]

  # HTTPS forcé
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !=https
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

  # www -> domaine nu
  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^ https://%1%{REQUEST_URI} [R=301,L]

  # Ancien nom de la landing -> racine (la chaîne de requête, ?v=b ou ?src=…, est conservée)
  RewriteRule ^validation\.html$ https://%{HTTP_HOST}/ [R=301,L]

  # Fichiers cachés, sauvegardes, sources et données : jamais servis
  RewriteRule (^|/)\. - [F,L]
  RewriteRule \.(sqlite|sqlite3|db|log|md|txt|ini|sh|bak|old|orig|swp|dist|json|lock|yml|yaml|sql|gz|zip)$ - [F,L,NC]
</IfModule>

<FilesMatch "^(config(\.example)?\.php|.*\.(sqlite|sqlite-wal|sqlite-shm|log))$">
  Require all denied
</FilesMatch>

<IfModule mod_headers.c>
  # Mêmes valeurs que lib/Http.php (les scripts PHP les posent aussi ; « set » remplace sans doublon).
  Header set Content-Security-Policy "default-src 'none'; script-src 'self'; style-src 'self'; img-src 'self'; font-src 'self'; connect-src 'self'; form-action 'self'; base-uri 'none'; frame-ancestors 'none'"
  Header set X-Content-Type-Options "nosniff"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  Header set X-Frame-Options "DENY"
  Header set Cross-Origin-Opener-Policy "same-origin"
  Header set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=(), interest-cohort=()"
  # HSTS : 1 an, sans « preload » ni « includeSubDomains » (app./api. sur un autre serveur, à décider plus tard)
  Header always set Strict-Transport-Security "max-age=31536000" "expr=%{HTTPS} == 'on'"
  Header always unset X-Powered-By
  Header unset X-Powered-By

  # Cache : HTML revalidé à chaque visite ; CSS et JS 1 jour (noms non versionnés) ; images et police 30 jours
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  <FilesMatch "\.(css|js)$">
    Header set Cache-Control "public, max-age=86400"
  </FilesMatch>
  <FilesMatch "\.(svg|woff2|png|jpg|webp|ico)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
</IfModule>

<IfModule mod_mime.c>
  AddType image/svg+xml .svg
  AddType font/woff2 .woff2
  AddType text/javascript .js
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/javascript application/javascript image/svg+xml text/plain
</IfModule>
