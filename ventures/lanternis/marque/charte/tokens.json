{
  "$description": "Lanternis : jetons de design, piste Veilleuse. Source de vérité de la charte (format inspiré du Design Tokens Community Group : $value, $type ; références entre accolades). Lanternis est une marque d'Hasteria SASU.",
  "meta": {
    "version": "1.0",
    "date": "2026-10-26",
    "auteur": "directeur-artistique",
    "statut": "à valider par le fondateur",
    "methode_contraste": "Luminance relative WCAG 2.x calculée à la main sur les codes hexadécimaux ; à recontrôler avec l'analyseur de la revue design.",
    "traduction_css": "tokens.css"
  },

  "couleur": {
    "base": {
      "nuit":          { "$type": "color", "$value": "#1B2330", "rvb": [27, 35, 48],    "role": "Fond de marque, texte principal sur clair, intérieur de l'arche du logo" },
      "nuit-douce":    { "$type": "color", "$value": "#2A3444", "rvb": [42, 52, 68],    "role": "Surfaces et cartes sur fond sombre" },
      "ambre":         { "$type": "color", "$value": "#F2B24C", "rvb": [242, 178, 76],  "role": "La lumière : accent, bouton principal, liens et alertes SUR FOND SOMBRE UNIQUEMENT" },
      "ambre-profond": { "$type": "color", "$value": "#8A5300", "rvb": [138, 83, 0],    "role": "L'ambre des fonds clairs : liens, échéances, alertes, focus" },
      "ambre-pale":    { "$type": "color", "$value": "#FBEBD0", "rvb": [251, 235, 208], "role": "Fond d'encadré ou de mise en avant sur clair ; jamais du texte" },
      "papier":        { "$type": "color", "$value": "#FAF6EE", "rvb": [250, 246, 238], "role": "Fond clair par défaut (site, application, documents)" },
      "blanc":         { "$type": "color", "$value": "#FFFFFF", "rvb": [255, 255, 255], "role": "Surfaces (cartes, champs) sur papier ; fond des emails" },
      "brume":         { "$type": "color", "$value": "#C5CDD8", "rvb": [197, 205, 216], "role": "Texte secondaire sur fond sombre uniquement" },
      "ardoise":       { "$type": "color", "$value": "#4A5260", "rvb": [74, 82, 96],    "role": "Texte secondaire sur fond clair" },
      "trait":         { "$type": "color", "$value": "#7A808B", "rvb": [122, 128, 139], "role": "Bordures de champs et de cases sur clair (composants, 3 : 1 minimum)" },
      "trait-nuit":    { "$type": "color", "$value": "#7D8899", "rvb": [125, 136, 153], "role": "Bordures de champs et de cases sur sombre" },
      "lin":           { "$type": "color", "$value": "#D9D2C3", "rvb": [217, 210, 195], "role": "Filets décoratifs sur clair (jamais porteurs de sens)" },
      "lin-nuit":      { "$type": "color", "$value": "#3A4558", "rvb": [58, 69, 88],    "role": "Filets décoratifs sur sombre (jamais porteurs de sens)" }
    },
    "etat": {
      "clair": {
        "succes": { "$type": "color", "$value": "#2F6B3F", "nom": "mousse", "rvb": [47, 107, 63] },
        "alerte": { "$type": "color", "$value": "{couleur.base.ambre-profond}", "nom": "ambre profond", "note": "Alerte = échéance ; pas de rouge pour une échéance" },
        "erreur": { "$type": "color", "$value": "#A1322A", "nom": "brique", "rvb": [161, 50, 42] },
        "info":   { "$type": "color", "$value": "#2F5470", "nom": "lac", "rvb": [47, 84, 112] }
      },
      "sombre": {
        "succes": { "$type": "color", "$value": "#8FC79A", "nom": "sauge", "rvb": [143, 199, 154] },
        "alerte": { "$type": "color", "$value": "{couleur.base.ambre}", "nom": "ambre" },
        "erreur": { "$type": "color", "$value": "#F08A7E", "nom": "corail", "rvb": [240, 138, 126] },
        "info":   { "$type": "color", "$value": "#9DBBD6", "nom": "ciel", "rvb": [157, 187, 214] }
      },
      "regle": "Une couleur d'état n'est jamais seule : toujours accompagnée d'un mot (« échéance dans 45 j ») ou d'une icône (RGAA 3.1)."
    },
    "theme": {
      "papier": {
        "fond":                 { "$value": "{couleur.base.papier}" },
        "surface":              { "$value": "{couleur.base.blanc}" },
        "surface-marque":       { "$value": "{couleur.base.nuit}" },
        "texte":                { "$value": "{couleur.base.nuit}" },
        "texte-secondaire":     { "$value": "{couleur.base.ardoise}" },
        "accent":               { "$value": "{couleur.base.ambre-profond}" },
        "mise-en-avant":        { "$value": "{couleur.base.ambre-pale}" },
        "bouton-fond":          { "$value": "{couleur.base.nuit}" },
        "bouton-texte":         { "$value": "{couleur.base.papier}" },
        "trait":                { "$value": "{couleur.base.trait}" },
        "filet":                { "$value": "{couleur.base.lin}" },
        "focus":                { "$value": "{couleur.base.ambre-profond}" },
        "logo": { "trait": "{couleur.base.nuit}", "interieur": "{couleur.base.nuit}", "lumiere": "{couleur.base.ambre}" }
      },
      "nuit": {
        "fond":                 { "$value": "{couleur.base.nuit}" },
        "surface":              { "$value": "{couleur.base.nuit-douce}" },
        "surface-marque":       { "$value": "{couleur.base.nuit-douce}" },
        "texte":                { "$value": "{couleur.base.papier}" },
        "texte-secondaire":     { "$value": "{couleur.base.brume}" },
        "accent":               { "$value": "{couleur.base.ambre}" },
        "mise-en-avant":        { "$value": "{couleur.base.nuit-douce}" },
        "bouton-fond":          { "$value": "{couleur.base.ambre}" },
        "bouton-texte":         { "$value": "{couleur.base.nuit}" },
        "trait":                { "$value": "{couleur.base.trait-nuit}" },
        "filet":                { "$value": "{couleur.base.lin-nuit}" },
        "focus":                { "$value": "{couleur.base.ambre}" },
        "logo": { "trait": "{couleur.base.papier}", "interieur": "{couleur.base.nuit-douce}", "lumiere": "{couleur.base.ambre}" }
      },
      "regle": "Le thème papier est le thème par défaut de l'application et des documents. Le thème nuit sert aux surfaces de marque (landing, réseaux) et au mode sombre choisi par l'utilisateur ou le système."
    }
  },

  "contrastes": {
    "seuils": { "texte_normal_AA": 4.5, "grand_texte_AA": 3, "composant_graphique": 3, "texte_AAA": 7 },
    "valides": [
      { "texte": "nuit",          "fond": "papier",        "rapport": 14.65, "niveau": "AAA" },
      { "texte": "nuit",          "fond": "blanc",         "rapport": 15.79, "niveau": "AAA" },
      { "texte": "nuit",          "fond": "ambre",         "rapport": 8.46,  "niveau": "AAA", "usage": "texte du bouton principal sur sombre" },
      { "texte": "nuit",          "fond": "ambre-pale",    "rapport": 13.46, "niveau": "AAA" },
      { "texte": "papier",        "fond": "nuit",          "rapport": 14.65, "niveau": "AAA" },
      { "texte": "papier",        "fond": "nuit-douce",    "rapport": 11.64, "niveau": "AAA" },
      { "texte": "ambre",         "fond": "nuit",          "rapport": 8.46,  "niveau": "AAA" },
      { "texte": "ambre",         "fond": "nuit-douce",    "rapport": 6.72,  "niveau": "AA (AAA grand texte)" },
      { "texte": "brume",         "fond": "nuit",          "rapport": 9.85,  "niveau": "AAA" },
      { "texte": "brume",         "fond": "nuit-douce",    "rapport": 7.83,  "niveau": "AAA" },
      { "texte": "ambre-profond", "fond": "papier",        "rapport": 5.87,  "niveau": "AA" },
      { "texte": "ambre-profond", "fond": "blanc",         "rapport": 6.33,  "niveau": "AA" },
      { "texte": "ambre-profond", "fond": "ambre-pale",    "rapport": 5.39,  "niveau": "AA" },
      { "texte": "ardoise",       "fond": "papier",        "rapport": 7.30,  "niveau": "AAA" },
      { "texte": "ardoise",       "fond": "blanc",         "rapport": 7.87,  "niveau": "AAA" },
      { "texte": "mousse",        "fond": "papier",        "rapport": 5.91,  "niveau": "AA" },
      { "texte": "brique",        "fond": "papier",        "rapport": 6.48,  "niveau": "AA" },
      { "texte": "lac",           "fond": "papier",        "rapport": 7.43,  "niveau": "AAA" },
      { "texte": "sauge",         "fond": "nuit",          "rapport": 8.13,  "niveau": "AAA" },
      { "texte": "sauge",         "fond": "nuit-douce",    "rapport": 6.46,  "niveau": "AA" },
      { "texte": "corail",        "fond": "nuit",          "rapport": 6.50,  "niveau": "AA" },
      { "texte": "corail",        "fond": "nuit-douce",    "rapport": 5.17,  "niveau": "AA" },
      { "texte": "ciel",          "fond": "nuit",          "rapport": 7.91,  "niveau": "AAA" },
      { "texte": "ciel",          "fond": "nuit-douce",    "rapport": 6.28,  "niveau": "AA" },
      { "texte": "trait (bordure)",      "fond": "papier",     "rapport": 3.68, "niveau": "composant >= 3 : 1 (pas du texte)" },
      { "texte": "trait (bordure)",      "fond": "blanc",      "rapport": 3.97, "niveau": "composant >= 3 : 1 (pas du texte)" },
      { "texte": "trait-nuit (bordure)", "fond": "nuit",       "rapport": 4.40, "niveau": "composant >= 3 : 1" },
      { "texte": "trait-nuit (bordure)", "fond": "nuit-douce", "rapport": 3.50, "niveau": "composant >= 3 : 1 (pas du texte)" }
    ],
    "interdits": [
      { "texte": "ambre",         "fond": "papier",     "rapport": 1.73, "raison": "Illisible : l'ambre ne vit que dans le noir. Utiliser l'ambre profond." },
      { "texte": "ambre",         "fond": "blanc",      "rapport": 1.87, "raison": "Idem." },
      { "texte": "ambre-profond", "fond": "nuit",       "rapport": 2.50, "raison": "Trop sombre sur nuit. Utiliser l'ambre." },
      { "texte": "brume",         "fond": "papier",     "rapport": 1.49, "raison": "Brume = texte secondaire du thème nuit seulement." },
      { "texte": "ardoise",       "fond": "nuit",       "rapport": 2.01, "raison": "Ardoise = texte secondaire du thème papier seulement." },
      { "texte": "trait",         "fond": "papier",     "rapport": 3.68, "raison": "Suffisant pour une bordure, insuffisant pour du texte." },
      { "texte": "lin",           "fond": "papier",     "rapport": 1.40, "raison": "Décoratif uniquement : jamais une bordure de champ ni une information." },
      { "texte": "lin-nuit",      "fond": "nuit",       "rapport": 1.63, "raison": "Décoratif uniquement." }
    ]
  },

  "typographie": {
    "famille": {
      "titre": { "$type": "fontFamily", "$value": ["Fraunces", "Iowan Old Style", "Palatino Linotype", "Palatino", "Georgia", "serif"], "licence": "SIL Open Font License 1.1 (à reconfirmer au téléchargement)", "fichier": "fonts/fraunces-latin-600.woff2", "graisse": 600, "poids_estime": "25 à 40 Ko (hypothèse, à mesurer)" },
      "texte": { "$type": "fontFamily", "$value": ["system-ui", "-apple-system", "Segoe UI", "Roboto", "Helvetica Neue", "Arial", "Noto Sans", "Liberation Sans", "sans-serif"], "poids": "0 Ko (polices du système)" },
      "mono":  { "$type": "fontFamily", "$value": ["ui-monospace", "Cascadia Mono", "Segoe UI Mono", "Menlo", "Consolas", "Liberation Mono", "monospace"], "usage": "identifiants, numéros de série, extraits techniques ; rare" },
      "email": { "$type": "fontFamily", "$value": ["Georgia", "Times New Roman", "serif"], "usage": "titres des emails (pas de webfont dans les emails) ; corps en Arial, Helvetica, sans-serif" }
    },
    "graisse": { "titre": 600, "texte": 400, "forte": 600 },
    "echelle_ecran": {
      "base_px": 16, "rapport": 1.25,
      "xs":  { "$type": "dimension", "$value": "0.8125rem", "px": 13, "usage": "mentions, légendes (minimum)" },
      "s":   { "$type": "dimension", "$value": "0.875rem",  "px": 14, "usage": "interface dense, tableaux" },
      "m":   { "$type": "dimension", "$value": "1rem",      "px": 16, "usage": "texte courant application" },
      "l":   { "$type": "dimension", "$value": "1.125rem",  "px": 18, "usage": "texte courant blog et landing" },
      "xl":  { "$type": "dimension", "$value": "1.25rem",   "px": 20, "usage": "titre 4, chapeau" },
      "2xl": { "$type": "dimension", "$value": "1.5625rem", "px": 25, "usage": "titre 3" },
      "3xl": { "$type": "dimension", "$value": "1.953rem",  "px": 31, "usage": "titre 2" },
      "4xl": { "$type": "dimension", "$value": "2.441rem",  "px": 39, "usage": "titre 1" },
      "5xl": { "$type": "dimension", "$value": "3.052rem",  "px": 49, "usage": "titre de landing, écran large" }
    },
    "echelle_impression": { "corps": "10pt", "petit": "8.5pt", "titre-3": "12pt", "titre-2": "16pt", "titre-1": "24pt", "couverture": "36pt" },
    "interligne": { "titre": 1.2, "texte": 1.55, "serre": 1.35 },
    "mesure_max": "68ch",
    "chiffres": "font-variant-numeric: tabular-nums (montants, dates, compteurs)",
    "regles": [
      "Fraunces uniquement pour les titres et les grandes citations, jamais pour un texte courant, un bouton ou un tableau.",
      "Pas de capitales sur plus de trois mots ; pas de texte justifié ; pas d'italique de Fraunces (non chargé).",
      "Montants en euros HT avec espace insécable fine avant le symbole (« 2 160 € HT »)."
    ]
  },

  "espacement": {
    "base_px": 4,
    "1": { "$type": "dimension", "$value": "4px" },
    "2": { "$type": "dimension", "$value": "8px" },
    "3": { "$type": "dimension", "$value": "12px" },
    "4": { "$type": "dimension", "$value": "16px" },
    "5": { "$type": "dimension", "$value": "24px" },
    "6": { "$type": "dimension", "$value": "32px" },
    "7": { "$type": "dimension", "$value": "48px" },
    "8": { "$type": "dimension", "$value": "64px" },
    "9": { "$type": "dimension", "$value": "96px" }
  },

  "grille": {
    "ecran": { "colonnes": 12, "gouttiere": "24px", "marge": "24px (16px sous 640px)", "largeur_contenu": "1120px", "largeur_texte": "672px" },
    "mobile": { "colonnes": 4, "gouttiere": "16px", "marge": "16px" },
    "points_de_rupture": { "s": "640px", "m": "960px", "l": "1200px" },
    "a4": { "marges": "16mm haut, 18mm côtés, 22mm bas", "colonnes": 6, "gouttiere": "5mm" },
    "zone_tactile_min": "44px x 44px"
  },

  "rayon": {
    "s":    { "$type": "dimension", "$value": "4px",   "usage": "cases, pastilles d'échéance" },
    "m":    { "$type": "dimension", "$value": "8px",   "usage": "boutons, champs" },
    "l":    { "$type": "dimension", "$value": "12px",  "usage": "cartes, panneaux" },
    "xl":   { "$type": "dimension", "$value": "16px",  "usage": "bandeaux de marque, visuels réseaux" },
    "rond": { "$type": "dimension", "$value": "999px", "usage": "puces, avatars" }
  },

  "ombre": {
    "1": { "$type": "shadow", "$value": "0 1px 2px rgba(27,35,48,0.08)", "usage": "carte au repos (facultatif)" },
    "2": { "$type": "shadow", "$value": "0 6px 16px rgba(27,35,48,0.12)", "usage": "menu, fenêtre de dialogue" },
    "theme_nuit": "pas d'ombre : un filet lin-nuit de 1px",
    "regle": "Un filet est préféré à une ombre. Jamais d'ombre sur le logo ni sur du texte."
  },

  "focus": { "epaisseur": "3px", "decalage": "2px", "couleur_papier": "{couleur.base.ambre-profond}", "couleur_nuit": "{couleur.base.ambre}" },

  "motif": {
    "halo": {
      "$value": "radial-gradient(circle, rgba(242,178,76,0.30) 0, rgba(242,178,76,0) 70%)",
      "regle": "Sur fond nuit uniquement ; en coin de bandeau ou derrière le symbole ; jamais derrière un texte ; un seul halo par écran."
    }
  },

  "mouvement": { "courte": "150ms", "moyenne": "250ms", "courbe": "cubic-bezier(0.2, 0, 0, 1)", "reduit": "0ms si prefers-reduced-motion" },

  "icone": { "grille": "24px", "trait": "2px", "extremites": "arrondies", "marge_interne": "2px", "style": "contour, aucun remplissage sauf le point de lumière" },

  "logo": {
    "fichiers": "logo/",
    "unite_X": "diamètre du foyer = 17/64 de la hauteur du symbole",
    "zone_protection": "1 X tout autour",
    "taille_min": { "logo_horizontal": "120px de large / 30mm", "symbole": "25px / 8mm", "symbole_compact": "16px / 5mm" }
  },

  "budget_sobriete": {
    "statut": "objectifs (hypothèses de travail, à mesurer en recette)",
    "police_titre": "<= 40 Ko, une seule graisse",
    "page_vitrine": "<= 500 Ko transférés au premier chargement",
    "image_contenu": "<= 100 Ko (AVIF ou WebP), largeur <= 1600px",
    "illustration_svg": "<= 5 Ko",
    "email": "<= 100 Ko HTML + images"
  }
}
